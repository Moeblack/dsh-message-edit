{
    "name":  "dsh-message-edit",
    "description":  "Bubble-level reply editing, branch-based message editing, rerolling, retrying, and version navigation for DeepSeek Harness conversations",
    "version": "0.3.1",
    "type":  "module",
    "main":  "./index.mjs",
    "exports":  {
                    ".":  "./index.mjs",
                    "./client":  "./client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "index.mjs",
                  "client.js",
                  "client.js.map",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
            },
    "scripts":  {
                    "build":  "node ./scripts/build.mjs",
                    "prepublishOnly":  "npm run build"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Moeblack/dsh-message-edit.git"
                   },
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "plugin",
                     "message-edit",
                     "reroll",
                     "retry",
                     "edit-reply"
                 ],
    "license":  "MIT",
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.2",
                            "@deepseek-ai/dsh-agent":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-agent-presets":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-api-session-controller":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-client-store":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-client-ui-chat":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-client-ui-conversation":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-client-ui-primitives":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-client-ui-renderer":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-client-ui-session":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-client-ui-slots":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-llm":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-session":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-session-query":  "0.1.5-rc.2",
                            "@deepseek-ai/dsh-workspace":  "0.1.5-rc.2",
                            "@types/react":  "^18.3.0",
                            "@types/react-dom":  "^18.3.0",
                            "lightningcss":  "^1.32.0",
                            "react":  "^18.2.0",
                            "tsdown":  "^0.22.2",
                            "typescript":  "^6.0.3"
                        }
}